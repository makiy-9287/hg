# ---- DeepSeek ----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
REASONING_EFFORT=low

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=8893521930:AAHh4kFLjh_PWLWzkCcu8OepukqKOJVWipw
TELEGRAM_CHAT_ID=5530953384

# api.telegram.org is blocked from some hosting regions. If startup reports
# "telegram UNREACHABLE", put a proxy here. Signals are queued and retried
# either way, and printed to the terminal so none are lost.
TELEGRAM_PROXY=
TELEGRAM_POLLING=1          # 0 = send signals but disable /commands
TELEGRAM_TIMEOUT=30
TELEGRAM_RETRY_SECONDS=60

# ---- Watchlist & schedule ----
WATCHLIST_SIZE=50           # top N by 24h volume, rebuilt daily
WATCHLIST_REFRESH=05:00
ACTIVE_START=05:00
ACTIVE_END=21:00
LOCAL_TZ=Asia/Colombo
ALIGN_OFFSET=20             # seconds after a candle close
# Scan once immediately on boot instead of waiting for the next 4h close.
# MIN_RESCAN_MINUTES stops repeated restarts from re-scanning.
SCAN_ON_START=1
MIN_RESCAN_MINUTES=60

# ---- Data ----
CANDLES=400                 # per timeframe: 1d, 4h, 1h, 15m

# ---- Agent ----
COINS_PER_REQUEST=25
POI_MAX_DIST_PCT=3.0        # POI must be this close to CMP to flag the coin
MAX_ACTIVE=3                # coins on the 15m list at once - this caps the bill
MAX_FLAGS_PER_SCAN=4        # agent must spend these slots on its best work
SETUP_MAX_HOURS=8           # a flagged setup expires after this
ACTIVE_BATCH=3              # coins per 15m-loop request

# Your DeepSeek rates, USD per 1M tokens (for /cost only)
PRICE_IN_HIT=0.014
PRICE_IN_MISS=0.28
PRICE_OUT=1.32

# ---- Monitor ----
MONITOR_SECONDS=60
